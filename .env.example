# ─── Contracts / Foundry ──────────────────────────────────────────────
# Copy to .env for Sepolia deployment. Never commit the filled-in file.

# Sepolia RPC endpoint and the deploying key.
SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=
PRIVATE_KEY=

# Anvil's first account, for `make deploy-local` only.
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Required by script/DeployAll.s.sol.
# USDC on Sepolia (from faucet.circle.com - verified contract on Sepolia Etherscan)
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# The AgriBridge verifier Safe (Sepolia): the only wallet granted VERIFIER_ROLE.
VERIFIER_ADDRESS=0xDa152AfD8C2efDA383fde6F840f590C93738de12

# Safe wallet receiving admin rights at the end of deployment.
# Defaults to VERIFIER_ADDRESS when unset.
ADMIN_ADDRESS=0xDa152AfD8C2efDA383fde6F840f590C93738de12

# Optional: the Chainlink Functions router on the target network (from Chainlink's docs). When set,
# the deploy scripts also deploy the world-price feeder; the Safe then sets its subscription.
FUNCTIONS_ROUTER=

# Optional: opt in to the Sepolia fork rehearsal (test/fork/SepoliaRehearsal.t.sol). It forks
# Sepolia locally and sends nothing to the network. Leave unset to skip it.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── Frontend (also place these in .env.local) ────────────────────────
# Printed by `make deploy-all`.
NEXT_PUBLIC_COMMODITY_CONFIG_ADDRESS=
NEXT_PUBLIC_COMMODITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_COMMODITY_TOKEN_ADDRESS=
NEXT_PUBLIC_COMMODITY_PRICE_ORACLE_ADDRESS=
NEXT_PUBLIC_AGRI_SHARE_TOKEN_ADDRESS=
NEXT_PUBLIC_LENDING_POOL_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# The verifier Safe. Only this wallet can open the verifier pages.
NEXT_PUBLIC_VERIFIER_SAFE=0xDa152AfD8C2efDA383fde6F840f590C93738de12

# 11155111 for Sepolia, 31337 for anvil
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=

# From cloud.walletconnect.com. Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=