# ─── Contracts / Foundry ──────────────────────────────────────────────
# Copy to .env for deployment. Never commit the filled-in file.

# Sepolia RPC endpoint and the deploying key.
SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=817EYQS7HQ2XFWWFM5DYR9C9PYWNMG87T4
PRIVATE_KEY=f42f9065336203e06f25c502fd462f769f30223fd2bdfe1b5492562685f9e7fa

# Anvil's first account, for `make deploy-local` only.
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Required by script/DeployAll.s.sol.
# USDC on Sepolia: claim test tokens from faucet.circle.com
USDC_CONTRACT_ADDRESS=
TOKEN_METADATA_BASE_URI=https://api.agribridge.io/metadata/

# Wallet granted VERIFIER_ROLE, used by the backend to approve commodities.
VERIFIER_ADDRESS=

# Optional: receives admin rights at the end of deployment. Defaults to the
# deploying account when unset.
ADMIN_ADDRESS=


# ─── Frontend (also place these in .env.local) ────────────────────────
# Printed by `make deploy-all`.
NEXT_PUBLIC_COMMODITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_COMMODITY_TOKEN_ADDRESS=
NEXT_PUBLIC_COMMODITY_PRICE_ORACLE_ADDRESS=
NEXT_PUBLIC_AGRI_SHARE_TOKEN_ADDRESS=
NEXT_PUBLIC_LENDING_POOL_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# 11155111 for Sepolia, 31337 for a local anvil chain.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=

# From cloud.walletconnect.com. Injected wallets such as MetaMask work
# without it; only the WalletConnect QR flow requires one.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
