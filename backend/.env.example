# ─── AgriBridge backend ───────────────────────────────────────────────
# Copy to backend/.env and fill in. Never commit the filled-in file.

PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────
# Required unless USE_MOCK_DB=true.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Serve an in-memory database instead of Supabase. For local UI work and the
# Playwright suite only. Refused when NODE_ENV=production.
USE_MOCK_DB=false

# ─── Session ──────────────────────────────────────────────────────────
# Required, minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Bound into the signed login message so a signature collected elsewhere
# cannot be replayed against this backend. Must match where the app is served.
APP_DOMAIN=localhost:3000
APP_URI=http://localhost:3000

# ─── Chain ────────────────────────────────────────────────────────────
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=11155111

# Wallet holding VERIFIER_ROLE on CommodityRegistry and PRICE_UPDATER_ROLE on
# the oracle. Used to approve and reject commodities on-chain.
VERIFIER_PRIVATE_KEY=

# ─── Contract addresses ───────────────────────────────────────────────
# Printed by `make deploy-all`.
COMMODITY_REGISTRY_ADDRESS=
COMMODITY_TOKEN_ADDRESS=
COMMODITY_PRICE_ORACLE_ADDRESS=
LENDING_POOL_ADDRESS=
LIQUIDITY_SHARE_TOKEN_ADDRESS=
